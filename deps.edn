{:paths ["src/main/clojure" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        com.cerner/clara-rules {:mvn/version "0.24.0"}
        http-kit/http-kit {:mvn/version "2.8.1"}
        compojure/compojure {:mvn/version "1.7.2"}
        ring/ring-defaults {:mvn/version "0.7.1"}
        hiccup/hiccup {:mvn/version "2.0.0"}
        com.cognitect/transit-clj {:mvn/version "1.1.363"}
        prismatic/schema {:mvn/version "1.4.2"}}

 :aliases
 {:dev {:extra-paths ["src/test/clojure"]}

  ;; Serves the release UI build.
  :ui {:extra-paths ["target/resources"]}

  ;; Serves the dev UI build; dev/user.clj starts shadow-cljs watching it. Use with :cljs.
  :ui-dev {:extra-paths ["target/dev" "dev"]}

  :test {:extra-paths ["src/test/clojure"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner" "-d" "src/test/clojure" "-r" "clara\\.tools\\..*test.*"]}

  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}
                       cider/cider-nrepl {:mvn/version "0.63.1"}}
          :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]" "--interactive"]}

  :cljs {:extra-paths ["src/main/clojurescript"]
         :extra-deps {thheller/shadow-cljs {:mvn/version "3.5.4"}
                      reagent/reagent {:mvn/version "1.3.0"}
                      com.cognitect/transit-cljs {:mvn/version "0.8.280"}}}

  :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd"}}
          :ns-default build}}}
